<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base da aplicação — SEM ActionBar para garantir que a faixa branca
         "Bíblia Inteligente IA" (vinda de android:label) NUNCA apareça acima do
         conteúdo do app, em nenhuma tela e em nenhuma situação (incluindo
         recreação de Activity, retomada vinda da Play Store, etc). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Tema principal (sem ActionBar) com suporte Edge-to-Edge -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Edge-to-Edge via EdgeToEdge.enable() no MainActivity cuida da transparência -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Tema de splash screen (transição inicial) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Após o splash, transitar para o tema sem ActionBar para esconder
             a faixa "Bíblia Inteligente IA" que vinha do android:label da Activity. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
